+// donel-dev: the exit thread and PtyKill both close the pseudoconsole; this guards the hand-off of `hpc` and the
+// erase of the baton, so a kill never touches a baton the exit thread already freed.
+static std::mutex g_ptyBatonMutex;
+
+// donel-dev: takes the pseudoconsole out of the baton, so it is closed only once. Call with g_ptyBatonMutex held.
+static HPCON TakePseudoConsole(pty_baton* baton) {
+  HPCON hpc = baton->hpc;
+  baton->hpc = nullptr;
+  return hpc;
+}
+
+// donel-dev: closes a pseudoconsole taken with TakePseudoConsole (outside the lock: on older Windows it waits for
+// conhost to drain its output, which the conout worker keeps reading).
+static void ClosePseudoConsoleTaken(HPCON hpc, HANDLE hLibrary, bool useConptyDll) {
+  if (hpc == nullptr || hLibrary == nullptr) return;
+  PFNCLOSEPSEUDOCONSOLE const pfnClosePseudoConsole = (PFNCLOSEPSEUDOCONSOLE)GetProcAddress(
+    (HMODULE)hLibrary,
+    useConptyDll ? "ConptyClosePseudoConsole" : "ClosePseudoConsole");
+  if (pfnClosePseudoConsole) pfnClosePseudoConsole(hpc);
+}
